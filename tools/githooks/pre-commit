#!/bin/sh
# The commit is coupled to the smoke test, mechanically (work order 126,
# part B; fundament decision 31). A commit once went through after a run
# had exited 139, because nothing connected the two. Now git itself runs
# the suite before it writes a commit, and any exit other than 0 — a
# failed assertion, a crash, a segfault (139), a kill (137) — refuses it.
#
# IT RUNS THE FAST TIER — work order 158, implementing 157's Option A.
# 157 measured the suite: seven checks are about half its wall time, and
# all seven are expensive for the same reason, standing screens up at
# many sizes or counts. They are declared in smoke_test.SLOW_TIER, each
# with the reason it is there, and --fast skips exactly those. The gate
# went from about 78 s to about 39 s on Data's machine.
#
# WHAT THAT COSTS, stated here rather than discovered later: a fault
# only those seven can see now lands at PUSH time instead of at commit
# time. The drop-marker hit area and the colony list's plating were both
# found by checks on that list. Data accepted this trade with work order
# 158, on one condition — that the push gate be as mechanical as this
# one, which is tools/githooks/pre-push. The full suite is not optional
# and has not moved out of git's way; it has moved one step later.
#
# THE TIER IS IN THE OUTPUT. A fast run prints "SMOKE TEST PASSED (FAST
# TIER)" with the number of checks it did not run, so a fast pass cannot
# be read as a full one in this hook's output or in a report.
#
# `python tools/smoke_test.py` with no flag still runs EVERYTHING. Only
# this hook passes --fast.
#
# Why a hook and not a wrapper script: a wrapper couples only the commits
# made through it, and a plain `git commit` is the one habit every session
# already has. The hook lives in the tree so it is versioned and reviewed
# like the suite; `tools/setup.py` points `core.hooksPath` here, because a
# clone does not inherit git config. `git commit --no-verify` bypasses it,
# and that is a deliberate act, not an accident.
#
# What it tests is the WORKING TREE, not only the staged content: the
# suite imports what is on disk. Commit from a tree whose unstaged state
# you would also accept.
#
# Exit 139 is not retried here. The rule is to re-run once BY HAND, record
# both exits, and never commit on the crashed run; a hook that retried
# would turn a sporadic crash into a green commit, which is the fault this
# file exists to close.
ROOT=$(cd "$(dirname "$0")/../.." && pwd)
LOG="$ROOT/.git/smoke-pre-commit.log"
[ -d "$ROOT/.git" ] || LOG="${TMPDIR:-/tmp}/orionlayer-smoke-pre-commit.log"
cd "$ROOT" || exit 1
python tools/smoke_test.py --quiet --fast >"$LOG" 2>&1
status=$?
if [ "$status" -ne 0 ]; then
    tail -n 30 "$LOG"
    echo "pre-commit: smoke test exited $status — commit refused (log: $LOG)"
    [ "$status" -eq 139 ] && echo "pre-commit: 139 is a segfault, not green. Re-run once by hand and record both exits."
    exit 1
fi
if ! grep -q "^SMOKE TEST PASSED" "$LOG"; then
    tail -n 30 "$LOG"
    echo "pre-commit: smoke test exited 0 without its PASSED line — commit refused (log: $LOG)"
    exit 1
fi
grep "^SMOKE TEST PASSED" "$LOG"
exit 0
