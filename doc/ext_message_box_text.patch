TEXTBOX::Do_Text_Box_ (with Text_Box_, Timed_Text_Box_, GENDRAW::Message_Box_,
Help_, COMBAT::Message_Box_Titled_, MAINSCR::Mini_Main_Screen_Text_Box_ and
HAROLD::User_Box_'s text types), GENDRAW::Message_Box_Exploding_ (with
