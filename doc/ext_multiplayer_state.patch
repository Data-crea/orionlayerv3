+                    snprintf(line, sizeof(line), "( GNN )  %.*s", (int)sizeof(msg.text), msg.text);
+                }
+                Write8(buf, msg.player_id);
+                WriteStr8(buf, line, sizeof(line));
+            }
+            break;
+        }
+        default:
+            break;
+        }
+    }
