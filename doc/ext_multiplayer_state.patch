+            for (int i = 0; i < MOX::_NUM_PLAYERS && i < MAX_PLAYERS; i++) {
+                if (MOX::_player[i].objectives == PLAYER_OBJECTIVE_HUMAN
+                    && MOX::_player[i].eliminated == 0) {
+                    Write8(buf, (uint8_t)i);
+                    Write8(buf, (uint8_t)(net.players_hit_next_turn[i] != 0));
+                }
+            }
