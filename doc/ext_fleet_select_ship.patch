+// ── Fleet box selection (OrionLayer, open fix 21) ────────
+
+// Select or deselect ONE ship of the stack the fleet box shows, the
+// way a human painting one icon cell does
+// (MAINSCR::Set_Painted_Fleet_Fields_, mainscr.cpp:2468): the same
+// Ship_Can_Be_Selected_ test, the same _ship_node[].selected write,
+// and the bit Save_Ship_Selection_Status_ keeps across a stack rebuild
+// (fleetpop.cpp:356-375). EVERY precondition is checked before
+// anything is written, so a refused command changes nothing. Unlike a
+// painted cell it reaches a ship scrolled out of the box's nine icons;
+// selecting it after scrolling is the same state.
+// Returns 1 applied, 0 refused.
+static int Select_Ship_(int16_t ship_idx, int16_t selected) {
+    if (!MOVEBOX::Moveable_Box_Selected_(2)) {
+        return 0;
+    }
+    const int16_t stack = MOX::_fleet_box_ship_stack;
+    if (stack < 0 || stack >= MOX::_ship_stack_count) {
+        return 0;
+    }
+    if (ship_idx < 0 || ship_idx >= MOX::_NUM_SHIPS) {
+        return 0;
+    }
+    if ((int16_t)(int8_t)MOX::_ship[ship_idx].owner != MOX::_PLAYER_NUM) {
+        return 0;
+    }
+    if (!MAINSCR::Ship_Can_Be_Selected_(ship_idx)) {
+        return 0;
+    }
+    int16_t node = MOX::_ship_stack_start[stack];
+    for (int guard = 0; node >= 0 && node < MAX_SHIPS && guard < MAX_SHIPS;
+         guard++) {
+        if (MOX::_ship_node[node].ship_idx == ship_idx) {
+            MOX::_ship_node[node].selected = (int8_t)(selected != 0 ? 1 : 0);
+            if (selected != 0) {
+                struct_::Set_Bit_Field_(MOX::_fleet_icon_selection_status,
+                                        (uint16_t)ship_idx);
+            } else {
+                struct_::Clear_Bit_Field_(MOX::_fleet_icon_selection_status,
+                                          (uint16_t)ship_idx);
+            }
+            return 1;
+        }
+        node = MOX::_ship_node[node].next_node;
+    }
+    return 0;
+}
