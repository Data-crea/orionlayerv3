From 04d7eee04b8f5234ca9ec245512cde368ee09b3c Mon Sep 17 00:00:00 2001
From: Data-crea <sattler.daniel@hotmail.com>
Date: Fri, 27 Nov 2026 13:33:40 +0100
Subject: [PATCH] OrionLayer Open Fix 134: an injected RIGHT click is put into
 the game's input queue by the call that reads it, like the left click of open
 fix 130 (with the window shown 4 of about 800 injected right clicks were
 lost, WO 444)

OrionLayer, open fix 134.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/ext/ext_api.cpp   | 9 +++++++++
 src/ext/ext_api.h     | 2 +-
 src/game/platform.cpp | 7 +++++++
 src/game/platform.h   | 1 +
 4 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/src/ext/ext_api.cpp b/src/ext/ext_api.cpp
index 173a6a4c..a65a3e10 100644
--- a/src/ext/ext_api.cpp
+++ b/src/ext/ext_api.cpp
@@ -3930,6 +3930,15 @@ static void ProcessInput() {
                 // the whole answer for a button and the wrong one for a
                 // grid field: the game reads xpos/ypos from the point.
                 Hold_Real_Mouse_();
+                // OrionLayer, open fix 134. The right button gets the same direct path as the left one (open fix 130): in
+                // Get_Input's own Tick DOWN and UP go into the game's input queue here and are read by the same call, so
+                // the game's Clear_Fields_Above() pump cannot fall between the SDL thread's two halves (4 of about 800
+                // injected right clicks were lost with the window shown, WO 444). One direct click per Tick, left or right.
+                if (g_click_direct_ok && !g_click_direct_used && !g_film.active) {
+                    g_click_direct_used = true;
+                    platform::Inject_Game_Right_Click((int16_t)cmd.param1, (int16_t)cmd.param2);
+                    break;
+                }
                 float wx = 0.0f;
                 float wy = 0.0f;
                 Game_Point_To_Window_Point_((float)cmd.param1,
diff --git a/src/ext/ext_api.h b/src/ext/ext_api.h
index c82bc2db..ca7b402c 100644
--- a/src/ext/ext_api.h
+++ b/src/ext/ext_api.h
@@ -511,7 +511,7 @@ bool Real_Mouse_Held();
 /// OrionLayer, open fix 130. True only while fields::Get_Input runs its own
 /// Tick, right before it reads the mouse (Interpret_Mouse_Input). An
 /// INJECT_CLICK drained there goes straight into the game's input queue
-/// (platform::Inject_Game_Click) and is read in the same call. Anywhere else
+/// (platform::Inject_Game_Click) and is read in the same call; an INJECT_RIGHT_CLICK likewise (open fix 134, platform::Inject_Game_Right_Click). Anywhere else
 /// (the input delay's Tick, the screen loop's Tick, a film) it takes the SDL
 /// path as before. The flag is set and cleared by Get_Input, game thread only.
 extern bool g_click_direct_ok;
diff --git a/src/game/platform.cpp b/src/game/platform.cpp
index 21e52d14..2cf0f20b 100755
--- a/src/game/platform.cpp
+++ b/src/game/platform.cpp
@@ -1851,6 +1851,13 @@ namespace platform {
         Set_Present_Mouse_Position(x, y);
     }
 
+    // OrionLayer, open fix 134. The same for the right button (mouse_buttons bit 1, value 2, as Forward_Game_Mouse_State gets it from the SDL path).
+    void Inject_Game_Right_Click(int16_t x, int16_t y) {
+        Enqueue_Mouse_Input_Event(x, y, 2);
+        Enqueue_Mouse_Input_Event(x, y, 0);
+        Set_Present_Mouse_Position(x, y);
+    }
+
     // OrionLayer, open fix 132. A wheel event for the game's own queue, as the SDL path (SDL_EVENT_MOUSE_WHEEL above) puts it:
     // wheel_x 0, wheel_y = notches (positive = up). x, y are game space already.
     void Inject_Game_Wheel(int16_t x, int16_t y, int16_t notches) {
diff --git a/src/game/platform.h b/src/game/platform.h
index 4d3a5cfc..da91d60b 100755
--- a/src/game/platform.h
+++ b/src/game/platform.h
@@ -87,6 +87,7 @@ namespace platform {
     void __cdecl Pump_Game_Input_Queue();
 #ifdef ORION2RE_EXT
     void Inject_Game_Click(int16_t x, int16_t y);
+    void Inject_Game_Right_Click(int16_t x, int16_t y);  // OrionLayer, open fix 134
     void Inject_Game_Wheel(int16_t x, int16_t y, int16_t notches);  // OrionLayer, open fix 132
 #endif
     int16_t __cdecl Get_Mouse_X();
