From 3d3c74b6f1f388457a9ccbdd0c22efe05bcd9bf5 Mon Sep 17 00:00:00 2001
From: Data-crea <sattler.daniel@hotmail.com>
Date: Mon, 12 Oct 2026 16:30:14 +0200
Subject: [PATCH] OrionLayer Open Fix 83: the gyro destabilizer's spin as a
 battle event (CEV_GYRO_SPIN: the turns the target spins after the line, the
 engine's own random draw, recorded before the spin as a note)

Ported onto orion2re v2.0.0 in scratch (work order 242 e) from local 910e1401:
renamed 3-way merge (identifier map cf4d9617->v2.0.0), clean.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/ext/ext_api.h     | 1 +
 src/game/cmbtspec.cpp | 3 +++
 2 files changed, 4 insertions(+)

diff --git a/src/ext/ext_api.h b/src/ext/ext_api.h
index 38e99a34..5b9bef7d 100644
--- a/src/ext/ext_api.h
+++ b/src/ext/ext_api.h
@@ -180,6 +180,7 @@ enum CombatEventType : uint8_t {
     CEV_SOUND_CHANGE = 20,  // handle (-1 every sound), change (1 fade, 2 loop, 3 pitch), value, ticks — OrionLayer, open fix 79.
     CEV_FIGHTER_BEAM = 21,  // missile, beam weapon, group x px, y px, facing, quantity, target x px, y px — OrionLayer, open fix 77.
     CEV_BEAM_AIM = 22,      // source, target, weapon, fire points, from x px, y px, to x px, y px (an entry's last fire point, the target and its miss offset) — OrionLayer, open fix 82.
+    CEV_GYRO_SPIN = 23,     // source, target, turns (sixteenths of a turn the target spins after the line's eight) — OrionLayer, open fix 83.
 };
 
 /// OrionLayer, open fix 58. One command per battle action (decision 52), consumed where the human's input is read.
diff --git a/src/game/cmbtspec.cpp b/src/game/cmbtspec.cpp
index 1bac52b8..77fd7ea7 100755
--- a/src/game/cmbtspec.cpp
+++ b/src/game/cmbtspec.cpp
@@ -601,6 +601,9 @@ namespace CMBTSPEC {
                 if (normalized_rotation != 15 && normalized_rotation >= 2) break;
                 rotations_left += (int16_t)game_random::Random(13);
             }
+#ifdef ORION2RE_EXT
+            ext::Combat_Note(ext::CEV_GYRO_SPIN, source_idx, target_idx, rotations_left);  // OrionLayer, open fix 83. The spin's count, from the engine's own random numbers.
+#endif
 
             graphics::Set_Window(0, 0, 639, 350);
             video::Clip_On();
