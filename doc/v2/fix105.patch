From 29c61acd08a57de34dd1e0303159bfbbaca21d24 Mon Sep 17 00:00:00 2001
From: Data-crea <sattler.daniel@hotmail.com>
Date: Tue, 20 Oct 2026 08:45:25 +0200
Subject: [PATCH] OrionLayer Open Fix 105: the Antaran room on the wire
 (ANTAROOM::Main_Antaran_Room_Screen reports id 82 and TPOP kind 22 while its
 loop runs: the message set, the full-screen field, and the ANTARMSG.LBX
 message as text; ended before the way out releases the message's block)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/ext/ext_api.cpp   |  5 +++++
 src/game/antaroom.cpp | 17 +++++++++++++++++
 2 files changed, 22 insertions(+)

diff --git a/src/ext/ext_api.cpp b/src/ext/ext_api.cpp
index 0524418c..51fb4fc5 100644
--- a/src/ext/ext_api.cpp
+++ b/src/ext/ext_api.cpp
@@ -1307,6 +1307,11 @@ static void SerializeState(std::vector<uint8_t>& buf,
     //                                                          [4] down [5] up [6] cancel
     //                                                          [7] OK [8] popup style;
     //                                                          text = the message
+    //     22    82  Antaran room (ANTAROOM::Main_Antaran_Room_Screen,
+    //               report.cpp:702; open fix 105)            [0] message set (1 before
+    //                                                          stardate 35000) [1] the
+    //                                                          full-screen field; text =
+    //                                                          the ANTARMSG.LBX message
     //
     //     Written: version, kind, n_args + args, title, text (int16
     //     length + raw bytes each), then per kind:
diff --git a/src/game/antaroom.cpp b/src/game/antaroom.cpp
index 778ad4ff..b4a3290e 100755
--- a/src/game/antaroom.cpp
+++ b/src/game/antaroom.cpp
@@ -1,4 +1,7 @@
 #include "pch.h"
+#ifdef ORION2RE_EXT
+#include "ext/ext_api.h"  // OrionLayer, open fix 105. TurnPopupGuard.
+#endif
 
 namespace ANTAROOM {
     s_colors antaran_room_normal_colors = {{250, 254, 255, 251, 252, 253, 254, 255}};
@@ -43,6 +46,14 @@ namespace ANTAROOM {
 
         Reload_Main_Antaran_Room_Screen();
         Get_Antaran_Room_Message(1 - message_set_index);
+#ifdef ORION2RE_EXT
+        // OrionLayer, open fix 105. The Antaran room on the wire while its
+        // loop runs: id 82, TPOP kind 22, the message as drawn (ext_api.cpp).
+        // Ended right after the loop: the message lives in screen_seg, which
+        // the way out releases.
+        ext::TurnPopupGuard ext_popup(82, 22, nullptr, antaran_room_message);
+        ext_popup.arg(0, message_set_index);
+#endif
 
         bool is_done = false;
         fields::Assign_Auto_Function(Draw_Main_Antaran_Room_Screen, 2);
@@ -52,6 +63,9 @@ namespace ANTAROOM {
             fields::Clear_Fields();
 
             int16_t hidden_field = fields::Add_Hidden_Field(0, 0, 639, 479, "", 0);
+#ifdef ORION2RE_EXT
+            ext_popup.arg(1, hidden_field);  // re-added every pass
+#endif
 
             if (fields::Get_Input() == hidden_field || key::Keyboard_Status()) {
                 is_done = true;
@@ -64,6 +78,9 @@ namespace ANTAROOM {
             }
         }
 
+#ifdef ORION2RE_EXT
+        ext_popup.end();
+#endif
         MOX::auto_turn_exit = 1;
         fields::Deactivate_Auto_Function();
         fields::Clear_Fields();
