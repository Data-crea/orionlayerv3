From 1982b2a109259d79f5429007bfc237a4ea8df9eb Mon Sep 17 00:00:00 2001
From: Data-crea <sattler.daniel@hotmail.com>
Date: Mon, 12 Oct 2026 16:25:30 +0200
Subject: [PATCH] Open fix 12: pop-move refusals without the message box
 (colmove)

The engine half of OrionLayer's open fix 12 (doc/ext_move_pop.patch):
_ext_suppress_refusal_help and Refusal_Help_, so MSG_SET_JOBS can reach
Give_Colonist_New_Job_'s refusals without opening a box that waits for a
human. The command itself is in src/ext, in the Extension API commit.

Committed as found (OrionLayer work order 126, part A).

Ported onto orion2re v2.0.0 in scratch (work order 242 e) from local 7067c366:
renamed merge; whitespace-insensitive hunk placement (v2 re-indented, e.g. namespace wrappers) for: src/game/colmove.cpp

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/game/colmove.cpp | 25 +++++++++++++++++++++----
 src/game/colmove.h   | 11 +++++++++++
 2 files changed, 32 insertions(+), 4 deletions(-)

diff --git a/src/game/colmove.cpp b/src/game/colmove.cpp
index c694740b..4be428a8 100755
--- a/src/game/colmove.cpp
+++ b/src/game/colmove.cpp
@@ -4,6 +4,23 @@ namespace COLMOVE {
     int16_t cluster_colony_n = -1;
     uint8_t g_hacky_dont_draw_cluster_flag;
 
+#ifdef ORION2RE_EXT
+    bool _ext_suppress_refusal_help = false;
+#endif
+
+    // The four refusals in Give_Colonist_New_Job each answer with
+    // GENDRAW::Help. This is that call in ONE place instead of
+    // four, so the refusal LOGIC keeps its single home in that
+    // function and only the drawing became optional.
+    static void Refusal_Help_(const char* message) {
+#ifdef ORION2RE_EXT
+        if (_ext_suppress_refusal_help) {
+            return;
+        }
+#endif
+        GENDRAW::Help(message);
+    }
+
     void __cdecl Draw_Cluster(int16_t x, int16_t y) {
         if (cluster_colony_n != -1 && !COLONY::full_draw) {
             if (Get_First_Unemployed(cluster_colony_n) != -1) {
@@ -523,21 +540,21 @@ namespace COLMOVE {
         int16_t pop_state = COLONY::Pop_To_Pop_State(colony_idx, pop_idx);
 
         if ((pop_state == 3 || pop_state == 6) && (new_job == ECON_RESEARCH || new_job == ECON_INDUSTRY)) {
-            GENDRAW::Help(ESTRINGS::E_Strings(ESTR_THIS_COLONIST_IS_A_NATIVE_NATIVES_CAN_ONLY_FARM_OR_MINE));
+            Refusal_Help_(ESTRINGS::E_Strings(ESTR_THIS_COLONIST_IS_A_NATIVE_NATIVES_CAN_ONLY_FARM_OR_MINE));
             return 0;
         }
 
         if (pop_state == 4) {
             int16_t current_job = (int16_t)POP::Get_Prof(MOX::colony[colony_idx].pop[pop_idx]);
             if (current_job != new_job) {
-                GENDRAW::Help(ESTRINGS::E_Strings(ESTR_THIS_COLONIST_IS_AN_ANDROID_AND_CANNOT_BE_RECONFIGURED_FOR_ANOTHER_JOB));
+                Refusal_Help_(ESTRINGS::E_Strings(ESTR_THIS_COLONIST_IS_AN_ANDROID_AND_CANNOT_BE_RECONFIGURED_FOR_ANOTHER_JOB));
                 return 0;
             }
         }
 
         int16_t sum_colonists = COLONY::Sum_Colonists(colony_idx, new_job, -1, -1, 0, -1);
         if (sum_colonists >= 42) {
-            GENDRAW::Help(ESTRINGS::E_Strings(ESTR_NO_ROOM_FOR_ANOTHER_COLONIST_IN_THIS_JOB_FIELD));
+            Refusal_Help_(ESTRINGS::E_Strings(ESTR_NO_ROOM_FOR_ANOTHER_COLONIST_IN_THIS_JOB_FIELD));
             return 0;
         }
 
@@ -552,7 +569,7 @@ namespace COLMOVE {
             return 1;
         }
 
-        GENDRAW::Help(ESTRINGS::E_Strings(ESTR_NO_ROOM_FOR_ANOTHER_COLONIST_IN_THIS_JOB_FIELD));
+        Refusal_Help_(ESTRINGS::E_Strings(ESTR_NO_ROOM_FOR_ANOTHER_COLONIST_IN_THIS_JOB_FIELD));
         return 0;
     }
 
diff --git a/src/game/colmove.h b/src/game/colmove.h
index 883f1aba..fe7931d0 100755
--- a/src/game/colmove.h
+++ b/src/game/colmove.h
@@ -6,6 +6,17 @@ namespace COLMOVE {
     extern uint8_t g_hacky_dont_draw_cluster_flag;
     extern bool native_population_transfer;
 
+#ifdef ORION2RE_EXT
+    // When set, Give_Colonist_New_Job still REFUSES exactly as it
+    // does otherwise and still returns 0 — it just does not open the
+    // message box on the way out. That box waits for a human
+    // (textbox.cpp:145-149) and the wait re-enters ext::Tick, so a
+    // refusal reached from the Extension API's own drain loop would
+    // stop the engine and recurse into itself. Nothing else reads
+    // this flag and it is never set outside ext::ProcessInput.
+    extern bool _ext_suppress_refusal_help;
+#endif
+
     // Draws the currently selected population cluster near the cursor.
     // @param x Screen-space X position for the cluster widget.
     // @param y Screen-space Y position for the cluster widget.
