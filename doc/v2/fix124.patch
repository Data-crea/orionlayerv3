From bf37dae6406da98d4b25c6e995f67aef89129cba Mon Sep 17 00:00:00 2001
From: Data-crea <sattler.daniel@hotmail.com>
Date: Thu, 26 Nov 2026 05:38:30 +0100
Subject: [PATCH] OrionLayer Open Fix 124: g_injected_mouse_pending is a
 std::atomic<bool> (the game thread sets and clears it, the main thread's SDL
 event loop reads it in Sync_Mouse_State_From_SDL; open fix 3's flag was a
 plain bool shared by two threads)

OrionLayer, open fix 124.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/ext/ext_api.cpp | 2 +-
 src/ext/ext_api.h   | 5 ++++-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/src/ext/ext_api.cpp b/src/ext/ext_api.cpp
index 805ea708..019b6edb 100644
--- a/src/ext/ext_api.cpp
+++ b/src/ext/ext_api.cpp
@@ -26,7 +26,7 @@ int16_t g_activated_input = 0;
 // OrionLayer, open fix 62. The rect the client saw at the pending index (x, y, x_end, y_end), when it sent one.
 static bool g_pending_checked = false;
 static int16_t g_pending_rect[4] = {0, 0, 0, 0};
-bool g_injected_mouse_pending = false;
+std::atomic<bool> g_injected_mouse_pending{false};  // OrionLayer, open fix 124.
 // OrionLayer, open fix 112. An injected click's release, held while a film plays (FilmGuard).
 static SDL_Event g_film_release{};
 static bool g_film_release_pending = false;
diff --git a/src/ext/ext_api.h b/src/ext/ext_api.h
index 96348ac4..a6d5df51 100644
--- a/src/ext/ext_api.h
+++ b/src/ext/ext_api.h
@@ -492,7 +492,10 @@ extern int16_t g_activated_input;
 /// pumped. Sync_Mouse_State_From_SDL stands aside while this is
 /// set, so the injected position survives to whoever reads
 /// mouse::Pointer_X(). Cleared by Pump_Game_Input_Queue().
-extern bool g_injected_mouse_pending;
+/// OrionLayer, open fix 124. Atomic: the game thread sets it (ProcessInput)
+/// and clears it (Pump_Game_Input_Queue), the main thread's SDL event loop
+/// reads it (Sync_Mouse_State_From_SDL).
+extern std::atomic<bool> g_injected_mouse_pending;
 
 /// OrionLayer, open fix 71. True when timer::Release_Time may return at once:
 /// a battle is live, the engine's window is hidden (open fix 43), a client is
