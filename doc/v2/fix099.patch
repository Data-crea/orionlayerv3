From 29047f2de146a51efb95f1f21ad40793e4f2c8ff Mon Sep 17 00:00:00 2001
From: Data-crea <sattler.daniel@hotmail.com>
Date: Sat, 17 Oct 2026 20:54:21 +0200
Subject: [PATCH] OrionLayer Open Fix 99: a bitmap line shorter than a
 hundredth of its picture's width is not drawn (Draw_Bitmap_Line scaled the
 picture to 0 % and divided by it: SIGFPE, seen on a tractor beam clipped to
 one pixel at the screen's edge)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/game/bitmap.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/game/bitmap.cpp b/src/game/bitmap.cpp
index 59a553f5..a42bc7a3 100755
--- a/src/game/bitmap.cpp
+++ b/src/game/bitmap.cpp
@@ -306,6 +306,15 @@ namespace bitmap {
             return;
         }
 
+        // OrionLayer, open fix 99. A line shorter than a hundredth of its
+        // picture's width scales the picture to 0 % (scale_factor below) and
+        // the scaling divides by it: SIGFPE. A tractor beam clipped at the
+        // screen's edge to one pixel (Draw_Clipped_Tractor_Line) is such a
+        // line. Nothing of it would be drawn: return before locking.
+        if (img->width <= 0 || (line_len * 100) / img->width == 0) {
+            return;
+        }
+
         video::g_screen_res_x = platform::Lock_Appropriate_Render_Buffer();
         uint8_t* video_page = (uint8_t*)video::current_video_page;
 
