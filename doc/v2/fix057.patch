From 9dc9601cdd40ebaa4fcc1a39872d870215ab8c28 Mon Sep 17 00:00:00 2001
From: Data-crea <sattler.daniel@hotmail.com>
Date: Mon, 12 Oct 2026 16:27:02 +0200
Subject: [PATCH] OrionLayer Open Fix 57: how the last battle ended, kept until
 the next ("CRES")

Ported onto orion2re v2.0.0 in scratch (work order 242 e) from local f1e6c581:
renamed merge; whitespace-insensitive hunk placement (v2 re-indented, e.g. namespace wrappers) for: src/game/combinit.cpp

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/ext/ext_api.cpp   | 67 +++++++++++++++++++++++++++++++++++++++++++
 src/ext/ext_api.h     | 42 +++++++++++++++++++++++++++
 src/game/combinit.cpp |  3 ++
 3 files changed, 112 insertions(+)

diff --git a/src/ext/ext_api.cpp b/src/ext/ext_api.cpp
index 69b30ec2..abb5a67b 100644
--- a/src/ext/ext_api.cpp
+++ b/src/ext/ext_api.cpp
@@ -1518,6 +1518,42 @@ static void SerializeState(std::vector<uint8_t>& buf,
             }
         }
     }
+
+    // 21. How the last battle ended: "CRES", written while a result is kept
+    //     (from just before End_Of_Combat until the next battle starts), on
+    //     ANY screen, after CMSL. OrionLayer, open fix 57.
+    if (g_combat_result.valid) {
+        const CombatResultView& r = g_combat_result;
+        buf.push_back((uint8_t)'C');
+        buf.push_back((uint8_t)'R');
+        buf.push_back((uint8_t)'E');
+        buf.push_back((uint8_t)'S');
+        Write8(buf, 1);                                   // block version
+        Write16(buf, (int16_t)r.number);
+        Write16(buf, (int16_t)r.serial);
+        Write8(buf, r.fought);
+        Write16(buf, r.winner);
+        Write16(buf, r.turn);
+        Write16(buf, r.star);
+        Write16(buf, r.colony);
+        Write16(buf, r.attacker);
+        Write16(buf, r.defender);
+        Write16(buf, r.colony_pop_lost);
+        Write32(buf, r.stardate);
+        Write16(buf, r.units);
+        for (int16_t i = 0; i < r.units; i++) {
+            const CombatResultUnit& u = r.unit[i];
+            Write16(buf, u.ship_idx);
+            Write8(buf, (uint8_t)u.owner);
+            Write8(buf, u.previous_owner);
+            Write8(buf, (uint8_t)u.unit_status);
+            Write8(buf, (uint8_t)u.is_retreating);
+            Write8(buf, (uint8_t)u.is_captured);
+            Write16(buf, u.structure_damage);
+            Write16(buf, u.armor_remaining);
+            Write16(buf, u.structure_max);
+        }
+    }
 }
 
 // ── Field list ───────────────────────────────────────────
@@ -2044,6 +2080,37 @@ uint16_t g_combat_serial = 0;
 CombatGuard::CombatGuard() : screen(SCREEN_EXT_COMBAT), previous(g_combat_live) {
     g_combat_live = true;
     ++g_combat_serial;
+    g_combat_result.valid = false;  // OrionLayer, open fix 57. A new battle: the last result goes.
+}
+
+// OrionLayer, open fix 57. How the last battle ended (ext_api.h).
+CombatResultView g_combat_result = {};
+
+void Record_Combat_Result(int16_t star_idx, int16_t colony_pop_lost,
+                          int16_t winner, bool fought) {
+    CombatResultView& r = g_combat_result;
+    r.valid = true;
+    ++r.number;
+    r.serial = fought ? g_combat_serial : 0;
+    r.fought = fought ? 1 : 0;
+    r.winner = winner;
+    r.turn = MOX::combat_turn;
+    r.star = star_idx;
+    r.colony = MOX::cmbt_colony_id;
+    r.attacker = MOX::combat_attacker_player;
+    r.defender = MOX::combat_defender_player;
+    r.colony_pop_lost = colony_pop_lost;
+    r.stardate = MOX::stardate;
+    int16_t units = MOX::combat_data != nullptr ? MOX::combat_total_ship_count : 0;
+    if (units < 0) units = 0;
+    if (units > 210) units = 210;
+    r.units = units;
+    for (int16_t i = 0; i < units; i++) {
+        const s_combat_data& d = MOX::combat_data[i];
+        r.unit[i] = {d.ship_idx, d.owner, d.previous_owner, d.unit_status,
+                     d.is_retreating, d.is_captured, d.structure_damage,
+                     d.armor_remaining, d.structure_max};
+    }
 }
 
 CombatGuard::~CombatGuard() {
diff --git a/src/ext/ext_api.h b/src/ext/ext_api.h
index b8db2d42..26405a07 100644
--- a/src/ext/ext_api.h
+++ b/src/ext/ext_api.h
@@ -102,6 +102,48 @@ constexpr int16_t SCREEN_EXT_COMBAT_BOARD = 67;
 extern bool g_combat_live;
 extern uint16_t g_combat_serial;
 
+/// OrionLayer, open fix 57. How a battle ended, recorded just before End_Of_Combat writes the losses back.
+///
+/// The end has no box and no input (combinit.cpp: End_Of_Combat), so a
+/// client saw the result only afterwards, as a changed ship[]. Recorded by
+/// Record_Combat_Result from COMBINIT::Tactical_Combat with the winner it
+/// hands End_Of_Combat (1 attacker, -1 defender — also after the 50-turn
+/// timeout — 666 both gone; 0 when the battle never started), and KEPT until
+/// the next battle starts: the stardate moves on in the same Next_Turn
+/// (nextturn.cpp), possibly before any tick, so "until the turn moves on"
+/// could send it never. `number` counts results; a client tells them apart
+/// by it.
+struct CombatResultUnit {
+    int16_t ship_idx;
+    int8_t owner;
+    uint8_t previous_owner;
+    int8_t unit_status;
+    int8_t is_retreating;
+    int8_t is_captured;
+    int16_t structure_damage;
+    int16_t armor_remaining;
+    int16_t structure_max;
+};
+struct CombatResultView {
+    bool valid;
+    uint16_t number;
+    uint16_t serial;       // g_combat_serial of the battle; 0 when not fought
+    uint8_t fought;
+    int16_t winner;
+    int16_t turn;
+    int16_t star;
+    int16_t colony;
+    int16_t attacker;
+    int16_t defender;
+    int16_t colony_pop_lost;
+    int32_t stardate;
+    int16_t units;
+    CombatResultUnit unit[210];
+};
+extern CombatResultView g_combat_result;
+void Record_Combat_Result(int16_t star_idx, int16_t colony_pop_lost,
+                          int16_t winner, bool fought);
+
 struct CombatGuard {
     ScreenOverride screen;
     bool previous;
diff --git a/src/game/combinit.cpp b/src/game/combinit.cpp
index 8e92c937..bf53fcbd 100755
--- a/src/game/combinit.cpp
+++ b/src/game/combinit.cpp
@@ -1353,6 +1353,9 @@ namespace COMBINIT {
             }
         }
 
+#ifdef ORION2RE_EXT
+        ext::Record_Combat_Result(star_idx, colony_pop, combat_winner, abort_tactical == 0);  // OrionLayer, open fix 57. The result, before End_Of_Combat writes it back.
+#endif
         End_Of_Combat(star_idx, colony_pop, combat_winner);
 
         if (combat_winner == 1 || combat_winner == 0x29A) {
