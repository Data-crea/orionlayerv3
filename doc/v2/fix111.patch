 // HELLO_REPLY's second word: what this server sends beyond protocol 1.
 constexpr uint16_t CAP_LAYOUT        = 0x0001;
+// OrionLayer, open fix 111. The server takes MSG_DEMOLISH; a client offers the demolish only then.
