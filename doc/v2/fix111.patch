index 31cc9805..a44acb97 100644
--- a/src/ext/ext_api.cpp
+++ b/src/ext/ext_api.cpp
@@ -3313,6 +3313,78 @@ static void Set_Spies_(const std::vector<uint8_t>& p) {
     BILL::Set_My_Agent_Number((uint8_t)agents);
