From 6800ee70ff93a96d60fea6598e6d69d990349511 Mon Sep 17 00:00:00 2001
From: Data-crea <sattler.daniel@hotmail.com>
Date: Mon, 12 Oct 2026 16:26:15 +0200
Subject: [PATCH] OrionLayer Open Fix 46: report the diplomacy audience as its
 own screen, 57 the player's and 58 the AI's

Ported onto orion2re v2.0.0 in scratch (work order 242 e) from local 8aea1a25:
renamed 3-way merge (identifier map cf4d9617->v2.0.0), clean.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/ext/ext_api.h          |  6 ++++++
 src/game/dip_scrn_main.cpp | 11 +++++++++++
 2 files changed, 17 insertions(+)

diff --git a/src/ext/ext_api.h b/src/ext/ext_api.h
index fc058402..84ddff30 100644
--- a/src/ext/ext_api.h
+++ b/src/ext/ext_api.h
@@ -48,6 +48,12 @@ struct ScreenOverride {
     ~ScreenOverride();
 };
 
+/// OrionLayer, open fix 46. The diplomacy audience has no screen id and runs under its
+/// caller's (6 the Races screen, 0 a turn-start report, 12 a sneak attack
+/// in turn processing): it reports 57 when the player opened it
+/// (DIP_SCRN::Diplomacy_Screen) and 58 when an AI asked for it
+/// (DIP_SCRN::Npc_Diplomacy_Screen), so a client can tell it is up.
+
 /// The field id of the input Get_Input() is returning THIS CALL when it
 /// came from a client's ACTIVATE_FIELD, and 0 when it came from the mouse.
 ///
diff --git a/src/game/dip_scrn_main.cpp b/src/game/dip_scrn_main.cpp
index 2883c49b..443448b1 100755
--- a/src/game/dip_scrn_main.cpp
+++ b/src/game/dip_scrn_main.cpp
@@ -1,4 +1,7 @@
 #include "pch.h"
+#ifdef ORION2RE_EXT
+#include "ext/ext_api.h"  // OrionLayer, open fix 46. ScreenOverride for the two audiences.
+#endif
 
 namespace DIP_SCRN {
     /**
@@ -1170,6 +1173,10 @@ namespace DIP_SCRN {
     }
 
     void __cdecl Diplomacy_Screen(int player_idx) {
+#ifdef ORION2RE_EXT
+        // OrionLayer, open fix 46. The player's audience reports a synthetic 57 (ext_api.h); the game still reads its caller's screen.
+        const ext::ScreenOverride ext_screen_guard(57);
+#endif
         diplomacy_current_music = -1;
         synch_up_established_flag = 0;
 
@@ -1261,6 +1268,10 @@ namespace DIP_SCRN {
         if (MOX::player[player_idx].eliminated == 1) {
             return;
         }
+#ifdef ORION2RE_EXT
+        // OrionLayer, open fix 46. An audience the AI asked for (turn start, report.cpp; a sneak attack, combfind.cpp) reports a synthetic 58 (ext_api.h).
+        const ext::ScreenOverride ext_screen_guard(58);
+#endif
 
         fields::Deactivate_Help_List();
         fields::Enable_Draw_All_Fields();
