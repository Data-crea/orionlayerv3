From 0b15e0b6a1ac09d070b8bc70242bac95f814672d Mon Sep 17 00:00:00 2001
From: Data-crea <sattler.daniel@hotmail.com>
Date: Mon, 12 Oct 2026 16:27:01 +0200
Subject: [PATCH] OrionLayer Open Fix 61: a right click at a point
 (MSG_INJECT_RIGHT_CLICK), so the F12 view can turn a ship on the battle map

Ported onto orion2re v2.0.0 in scratch (work order 242 e) from local ab3f6892:
renamed 3-way merge (identifier map cf4d9617->v2.0.0), clean.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/ext/ext_api.cpp    | 29 +++++++++++++++++++++++++++++
 src/ext/ext_server.cpp | 11 +++++++++++
 src/ext/ext_server.h   |  2 ++
 3 files changed, 42 insertions(+)

diff --git a/src/ext/ext_api.cpp b/src/ext/ext_api.cpp
index 1d564765..113adfed 100644
--- a/src/ext/ext_api.cpp
+++ b/src/ext/ext_api.cpp
@@ -1836,6 +1836,35 @@ static void ProcessInput() {
             g_hide_window = (cmd.param1 == 0);
             break;
 
+        case MSG_INJECT_RIGHT_CLICK:
+            // OrionLayer, open fix 61. INJECT_CLICK with the right button: a grid field reads the point (the battle map's turn-to-face, combat1.cpp:696-710).
+            {
+                // CANCEL_FIELD right-clicks a field's CENTRE, which is
+                // the whole answer for a button and the wrong one for a
+                // grid field: the game reads xpos/ypos from the point.
+                g_injected_mouse_pending = true;
+                float wx = 0.0f;
+                float wy = 0.0f;
+                Game_Point_To_Window_Point_((float)cmd.param1,
+                                            (float)cmd.param2,
+                                            &wx, &wy);
+                SDL_Event down{};
+                down.type = SDL_EVENT_MOUSE_BUTTON_DOWN;
+                down.button.button = SDL_BUTTON_RIGHT;
+                down.button.x = wx;
+                down.button.y = wy;
+                down.button.down = true;
+                SDL_PushEvent(&down);
+                SDL_Event up{};
+                up.type = SDL_EVENT_MOUSE_BUTTON_UP;
+                up.button.button = SDL_BUTTON_RIGHT;
+                up.button.x = wx;
+                up.button.y = wy;
+                up.button.down = false;
+                SDL_PushEvent(&up);
+            }
+            break;
+
         case MSG_CANCEL_FIELD:
             // Right-click on field (DOWN + UP)
             if (cmd.param1 >= 0 && cmd.param1 < fields::fields_count) {
diff --git a/src/ext/ext_server.cpp b/src/ext/ext_server.cpp
index 23ed4df5..2e457bcb 100644
--- a/src/ext/ext_server.cpp
+++ b/src/ext/ext_server.cpp
@@ -222,6 +222,17 @@ void Server::HandleClientMessage(Client& client) {
         }
         break;
     }
+    case MSG_INJECT_RIGHT_CLICK: {
+        // OrionLayer, open fix 61. int16 x, int16 y; shorter is dropped, never guessed.
+        if (payload_len >= 4) {
+            InputCommand cmd{};
+            cmd.type = MSG_INJECT_RIGHT_CLICK;
+            memcpy(&cmd.param1, payload, 2);
+            memcpy(&cmd.param2, payload + 2, 2);
+            input_queue_.push_back(cmd);
+        }
+        break;
+    }
     case MSG_CANCEL_FIELD: {
         if (payload_len >= 2) {
             InputCommand cmd{};
diff --git a/src/ext/ext_server.h b/src/ext/ext_server.h
index 4d9d4c4b..400a6e93 100644
--- a/src/ext/ext_server.h
+++ b/src/ext/ext_server.h
@@ -42,6 +42,8 @@ constexpr uint16_t MSG_SET_JOBS      = 0x84;
 constexpr uint16_t MSG_SELECT_SHIP   = 0x85;
 // OrionLayer, open fix 43. Show (1) or hide (0) the engine's own window: uint8 show.
 constexpr uint16_t MSG_SHOW_WINDOW   = 0x86;
+// OrionLayer, open fix 61. A RIGHT click at (x, y) in 640x480 space: int16 x, int16 y.
+constexpr uint16_t MSG_INJECT_RIGHT_CLICK = 0x87;
 
 // Subscription flags (bitmask)
 constexpr uint16_t SUB_STATE         = 0x01;
