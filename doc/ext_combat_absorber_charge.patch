 3 files changed, 14 insertions(+)

diff --git a/src/ext/ext_api.h b/src/ext/ext_api.h
index 45890177..428ceb50 100644
--- a/src/ext/ext_api.h
+++ b/src/ext/ext_api.h
@@ -186,6 +186,7 @@ enum CombatEventType : uint8_t {
     CEV_FIGHTER_BEAM = 21,  // missile, beam weapon, group x px, y px, facing, quantity, target x px, y px — OrionLayer, open fix 77.
     CEV_BEAM_AIM = 22,      // source, target, weapon, fire points, from x px, y px, to x px, y px (an entry's last fire point, the target and its miss offset) — OrionLayer, open fix 82.
     CEV_GYRO_SPIN = 23,     // source, target, turns (sixteenths of a turn the target spins after the line's eight) — OrionLayer, open fix 83.
+    CEV_ABSORB = 24,        // unit, charge after, change (the Energy Absorber's reflected_damage_pool: charged by a hit, emptied by its discharge or its side's turn) — OrionLayer, open fix 94.
 };
 
 /// OrionLayer, open fix 58. One command per battle action (decision 52), consumed where the human's input is read.
diff --git a/src/game/cmbtfire.cpp b/src/game/cmbtfire.cpp
index ce9f0d76..7b2b28f8 100755
--- a/src/game/cmbtfire.cpp
+++ b/src/game/cmbtfire.cpp
@@ -933,6 +933,9 @@ namespace CMBTFIRE {
                     (int32_t)MOX::combat_data[target_ship_idx]
                         .reflected_damage_pool +
                     reflected);
+#ifdef ORION2RE_EXT
+            ext::Combat_Note(ext::CEV_ABSORB, target_ship_idx, MOX::combat_data[target_ship_idx].reflected_damage_pool, reflected);  // OrionLayer, open fix 94. The charge as it is taken: before the shot's animation, which runs after every shot's damage (Fire_Ship).
+#endif
         }
 
         if (COMBINIT::Does_Combat_Ship_Have_Special(
@@ -2003,6 +2006,11 @@ namespace CMBTFIRE {
                 source_ship_idx);
         }
 
+#ifdef ORION2RE_EXT
+        if (MOX::combat_data[source_ship_idx].reflected_damage_pool != 0) {
+            ext::Combat_Note(ext::CEV_ABSORB, source_ship_idx, 0, (int16_t)-MOX::combat_data[source_ship_idx].reflected_damage_pool);  // OrionLayer, open fix 94. Emptied after the discharge's animation.
+        }
+#endif
         MOX::combat_data[source_ship_idx].reflected_damage_pool = 0;
     }
 
diff --git a/src/game/combat1.cpp b/src/game/combat1.cpp
index f0ce36b3..401f7e1c 100755
--- a/src/game/combat1.cpp
+++ b/src/game/combat1.cpp
@@ -1222,6 +1222,11 @@ namespace COMBAT1 {
                 if (Combat_Ship_Participates_In_Current_Pass(i)) {
                     if (absorber_keep_charge == 0 &&
                         MOX::combat_data[i].owner == active_player_id) {
+#ifdef ORION2RE_EXT
+                        if (MOX::combat_data[i].reflected_damage_pool != 0) {
+                            ext::Combat_Note(ext::CEV_ABSORB, i, 0, (int16_t)-MOX::combat_data[i].reflected_damage_pool);  // OrionLayer, open fix 94. Emptied as its side's turn begins.
+                        }
+#endif
                         MOX::combat_data[i].reflected_damage_pool = 0;
                     }
                 }
