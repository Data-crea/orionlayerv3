     _old_race = 0;
     video::Set_Page_Off_();
+#ifdef ORION2RE_EXT
+        MOX::_current_screen = SCREEN_RACE;
+#endif
     Draw_Race_Selection_Screen_();
     palstore::Darken_Palette_(100);
     palette::Clear_Palette_Changes_(0, 0xFF);
@@ -447,6 +450,13 @@
     fields::Clear_Fields_();
     raceopt::Convert_Player_To_Flags_(player);
