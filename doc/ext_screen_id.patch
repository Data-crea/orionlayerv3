+    // active so external clients can route to it; restore on cancel.
+    const int16_t ext_saved_screen = MOX::_current_screen;
+    MOX::_current_screen = 50;
+#endif
     memcpy(raceopt::_cur_race_name, player_race_name, strlen(player_race_name) + 1);
